# Build output
bin/
obj/
artifacts/
TestResults/

# Editors and local settings
.vs/
.vscode/
.idea/
*.user
*.suo

# Local-only material: internal notes, plans and agent traces. Never published.
.internal/
.superpowers/
.claude/
*.local.*
.env
.env.*

# Health check reports written to the working folder
engage-healthcheck-*.json

# Logs from local runs
*.log
logs/

# Generated by the Umbraco build in host projects
hosts/*/appsettings-schema*.json
hosts/*/umbraco-package-schema.json
hosts/*/umbraco/

# Copied into V13 host folders by the Umbraco.Engage / Engage.Forms V13 package build targets
hosts/*/App_Plugins/
hosts/*/Assets/
hosts/*/Views/
