{
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UpgradeUnattended": true,
        "UnattendedUserName": "Health Check",
        "UnattendedUserEmail": "healthcheck@localhost.test",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "ModelsBuilder": { "ModelsMode": "Nothing" },
      "Global": { "InstallMissingDatabase": false }
    }
  },
  "Engage": {
    "Reporting": { "DataGenerationEnabled": false }
  }
}
