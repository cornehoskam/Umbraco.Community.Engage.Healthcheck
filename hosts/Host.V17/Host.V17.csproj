<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EngageVersion Condition="'$(EngageVersion)' == ''">17.5.0</EngageVersion>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">17.5.3</UmbracoVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoVersion)" />
    <PackageReference Include="Umbraco.Engage" Version="$(EngageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(EngageFormsVersion)' != ''">
    <PackageReference Include="Umbraco.Engage.Forms" Version="$(EngageFormsVersion)" />
    <PackageReference Include="Umbraco.Forms" Version="$(UmbracoFormsVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(EngageCommerceVersion)' != ''">
    <PackageReference Include="Umbraco.Engage.Commerce" Version="$(EngageCommerceVersion)" />
    <PackageReference Include="Umbraco.Commerce" Version="$(UmbracoCommerceVersion)" />
  </ItemGroup>
</Project>
