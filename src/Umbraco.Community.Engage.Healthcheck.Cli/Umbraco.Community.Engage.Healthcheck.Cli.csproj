<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>engage-healthcheck</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>engage-healthcheck</ToolCommandName>
    <!-- Runs on .NET 10 or any newer runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Optional stand-alone builds (dotnet publish -r <rid>): one file with the .NET runtime inside. The release itself is
       the universal build that runs with dotnet. No trimming or Native AOT: Microsoft.Data.SqlClient supports neither.
       No InvariantGlobalization: SqlClient refuses it on connect. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.Engage.Healthcheck.Core\Umbraco.Community.Engage.Healthcheck.Core.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
